# ================================
# APPLICATION
# ================================
APP_NAME=QuantVision
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=True

# Local service ports
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173

# ================================
# API SECURITY
# ================================
# Leave QUANTVISION_API_KEY unset for local development and every endpoint is open.
# Set it (and set VITE_API_KEY to the same value for the frontend) before exposing
# the server on any interface other than localhost — the training, agent and
# backtest routes start expensive work and are otherwise unauthenticated.
QUANTVISION_API_KEY=
# Comma-separated allowed browser origins. Defaults to the local dev servers.
QUANTVISION_CORS_ORIGINS=

# Optional: override the model used by the CrewAI agent routes.
# QUANTVISION_AGENT_MODEL=anthropic/claude-opus-5

# ================================
# FORECAST QUALITY
# ================================
# Return-regression bundles are served only when training recorded that they beat
# the constant predictor "always answer with the mean of the training targets".
# Bundles trained before this check existed carry no such record and are refused,
# because those are the ones that returned a fixed number for every input.
# Set to false to serve unproven bundles anyway while you retrain.
QUANTVISION_ENFORCE_MODEL_SKILL=true

# ================================
# AUTOMATIC MODEL PREPARATION
# ================================
# Selecting a ticker is the whole user action: when a serving route finds nothing
# to serve, it starts training in the background and the client polls the job.
# Set false to switch that off — the API then answers "not prepared" and only an
# explicit POST /api/models/{symbol}/prepare trains anything.
QUANTVISION_AUTO_PREPARE=true

# Age at which a trained artifact is refreshed in the background. Stale artifacts
# keep serving while the refresh runs, so this never blanks the UI. 0 disables the
# age policy entirely.
QUANTVISION_MODEL_MAX_AGE_DAYS=30

# Concurrent preparation jobs. Training is CPU-bound; a wide pool starves the
# inference path and makes every other symbol on the dashboard slow. Jobs beyond
# this queue rather than being dropped.
QUANTVISION_PREPARE_WORKERS=1

# How long after a finished attempt a symbol may be prepared again. This is the
# guard that stops a doomed run repeating on every page load — a model type that
# errors every time, or bundles that train and then fail their skill gate. A user
# pressing Retry bypasses it.
QUANTVISION_PREPARE_COOLDOWN_SECONDS=900

# ================================
# DATA SOURCES
# ================================
# Primary market data source is yfinance and does not require a key.
# Alpha Vantage is optional and only used by endpoints that support it.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Historical download helpers
DATA_START_DATE=2019-01-01
DATA_END_DATE=2024-12-31
ENABLE_SP500=True
ENABLE_RUSSELL2000=False

# ================================
# MODEL AND BACKTEST DEFAULTS
# ================================
DEFAULT_MODEL=xgboost
LOOKBACK_PERIOD=60
TRAIN_TEST_SPLIT=0.8
RISK_FREE_RATE=0.04
INITIAL_CAPITAL=100000
COMMISSION_RATE=0.0
SLIPPAGE_RATE=0.001

# ================================
# AGENT WORKFLOWS
# ================================
# Optional. Only needed if you want CrewAI-backed analysis routes/tools.
ANTHROPIC_API_KEY=your_anthropic_api_key
QUANTVISION_API_URL=http://localhost:8000

# ================================
# DATABASE
# ================================
# sqlite (default) or timescale. `timescale` makes /api/data/prices read and
# write the daily_prices hypertable via the settings below; anything else and the
# API answers from the data providers only.
DB_TYPE=sqlite
SQLITE_DB_PATH=database/stock_data.db

# PostgreSQL / TimescaleDB settings, used when DB_TYPE=timescale.
# Start the server with: docker compose -f docker/docker-compose.yml up -d timescaledb
# POSTGRES_HOST is `localhost` for an API run on the host; inside the api
# container it must be `timescaledb`, the compose service name.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stock_data
