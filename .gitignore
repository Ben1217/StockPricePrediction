# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.venv/

# Environment variables
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Testing
.pytest_cache/
pytest-cache-files-*/
.coverage
htmlcov/
.mypy_cache/

# Agent and tool logs
.codex-logs/

# Build
build/
dist/
*.egg-info/

# Data files (too large for git)
data/raw/
data/processed/
data/indicators/
data/cache/
*.csv
*.parquet

# Direction backtest artifacts (regenerate via scripts/direction_backtest.py).
# Derived outputs, and the report JSON embeds a data hash tied to the exact bars
# it was run on — committing one invites comparing two runs that never saw the
# same data.
data/direction_backtests/

# Model files (too large for git — regenerate via POST /api/training/bootstrap)
models/bundles/
models/model_metadata/
models/saved_models/
models/scalers/

# Vendored third-party model repos (cloned, not committed)
vendor/

# Database
database/*.db
database/*.sqlite
data/*.db

# Logs
logs/**/*.log

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.diff
temp_hist.txt
data/sector_cache.json
